rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------------
    // GLOBAL HELPERS
    // --------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    
    function existing() {
      return resource.data;
    }
    
    function incoming() {
      return request.resource.data;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'superadmin';
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'superadmin' || getUserRole() == 'admin');
    }

    function isManager() {
      return isSignedIn() && (getUserRole() == 'superadmin' || getUserRole() == 'admin' || getUserRole() == 'manager');
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --------------------------------------------------------------------------
    // VALIDATION HELPERS
    // --------------------------------------------------------------------------
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role'])
          && data.email is string && data.email.size() > 0 && data.email.size() <= 200
          && data.role is string && (data.role == 'superadmin' || data.role == 'admin' || data.role == 'manager' || data.role == 'customer');
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['nameEn', 'nameHi', 'displayOrder', 'isActive'])
          && data.nameEn is string && data.nameEn.size() <= 100
          && data.nameHi is string && data.nameHi.size() <= 100
          && data.displayOrder is number
          && data.isActive is bool;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'categoryId', 'isActive', 'isAvailable'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.price is number && data.price >= 0
          && data.categoryId is string && data.categoryId.size() > 0
          && data.isActive is bool
          && data.isAvailable is bool;
    }
    
    function isValidSeat(data) {
      return data.keys().hasAll(['isOccupied', 'updatedAt'])
          && data.isOccupied is bool;
    }

    function isClientProductUpdate(isCreate) {
      let aiFields = ['aiSearchAliases', 'searchStatus', 'searchError', 'searchErrorAt', 'processingAttempts', 'processingStartedAt', 'processingJobId', 'lastProcessedAt', 'serverSignature'];
      return isCreate
          ? (!incoming().keys().hasAny(aiFields) && incoming().productVersion == 1)
          : (!incoming().diff(existing()).affectedKeys().hasAny(aiFields) && incoming().productVersion == (existing().get('productVersion', 0) + 1));
    }
    
    function isValidRelationship(data) {
      return data.keys().hasAll(['participants', 'type', 'confidence', 'source', 'status', 'updatedAt', 'createdAt'])
          && data.participants is list
          && data.participants.size() == 2
          && data.participants[0] is string
          && data.participants[1] is string
          && data.participants[0] < data.participants[1]
          && (data.type == 'similar' || data.type == 'complementary')
          && data.confidence is number
          && data.confidence >= 0.0 && data.confidence <= 1.0
          && (data.source == 'manual' || data.source == 'ai')
          && (data.status == 'pending' || data.status == 'approved' || data.status == 'blocked')
          && data.createdAt is number
          && data.updatedAt is number;
    }

    // --------------------------------------------------------------------------
    // CATCH ALL (DEFAULT DENY)
    // --------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // --------------------------------------------------------------------------
    // COLLECTIONS
    // --------------------------------------------------------------------------
    
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isManager());
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId && incoming().role == existing().role && incoming().email == existing().email);
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isManager() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isManager() && isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isSuperAdmin() && isValidId(categoryId);
    }
    
    match /products/{productId} {
      allow read: if true;
      allow create: if isManager() && isValidId(productId) && isValidProduct(incoming()) && isClientProductUpdate(true);
      allow update: if isManager() && isValidId(productId) && isValidProduct(incoming()) && isClientProductUpdate(false);
      allow delete: if isSuperAdmin() && isValidId(productId);
    }

    match /productRecommendations/{id} {
      // Customers can only read approved recommendations
      allow read: if resource.data.status == 'approved' || isManager();
      
      // Only admins/managers can create/update manually.
      // AI creations happen via the secure backend using Admin SDK.
      allow create, update: if isManager() 
          && request.resource.data.source == 'manual';
          
      allow delete: if isManager();
    }
    
    match /productRelationships/{relId} {
      allow read, write: if false; // Deprecated, backend only migration
    }


    match /searchMappings/{mappingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /seats/{seatId} {
      allow read: if isManager();
      allow create: if isManager() && isValidId(seatId) && isValidSeat(incoming());
      allow update: if isManager() && isValidId(seatId) && isValidSeat(incoming());
      allow delete: if isSuperAdmin() && isValidId(seatId);
    }
    match /seatAvailability/{seatId} {
      allow read: if true;
      allow write: if isManager();
    }
  }
}
